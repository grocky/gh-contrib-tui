#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  github-contrib USERNAME [--from YYYY-MM-DD] [--to YYYY-MM-DD]

Examples:
  github-contrib octocat
  github-contrib octocat --from 2026-01-01
  github-contrib octocat --from 2026-01-01 --to 2026-12-31

Notes:
  - Requires GitHub CLI auth: gh auth status
  - Dates must be in YYYY-MM-DD format
  - If --from is set without --to, --to defaults to today's UTC date
USAGE
}

normalize_date() {
  local input="$1"
  local bound="$2"
  local parsed

  if [[ ! "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    echo "Invalid date format: $input (expected YYYY-MM-DD)" >&2
    exit 1
  fi

  # Validate the date by parsing it in UTC.
  if ! parsed="$(date -u -d "$input" +%Y-%m-%d 2>/dev/null)"; then
    echo "Invalid date value: $input" >&2
    exit 1
  fi
  if [[ "$parsed" != "$input" ]]; then
    echo "Invalid date value: $input" >&2
    exit 1
  fi

  if [[ "$bound" == "start" ]]; then
    echo "${input}T00:00:00Z"
  else
    echo "${input}T23:59:59Z"
  fi
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" || $# -lt 1 ]]; then
  usage
  exit 0
fi

login="$1"
shift

from=""
to=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)
      from="${2:-}"
      shift 2
      ;;
    --to)
      to="${2:-}"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ -z "$from" && -n "$to" ]]; then
  echo "--from is required when --to is provided" >&2
  exit 1
fi

if [[ -n "$from" ]]; then
  if [[ -z "$to" ]]; then
    to="$(date -u +%Y-%m-%d)"
  fi

  from_iso="$(normalize_date "$from" "start")"
  to_iso="$(normalize_date "$to" "end")"

  gh api graphql -f query='query($login: String!, $from: DateTime!, $to: DateTime!) {
    user(login: $login) {
      login
      name
      contributionsCollection(from: $from, to: $to) {
        contributionCalendar {
          totalContributions
          weeks {
            contributionDays {
              date
              contributionCount
              color
            }
          }
        }
        totalCommitContributions
        totalIssueContributions
        totalPullRequestContributions
        totalPullRequestReviewContributions
        startedAt
        endedAt
      }
    }
  }' -f login="$login" -f from="$from_iso" -f to="$to_iso"
else
  gh api graphql -f query='query($login: String!) {
    user(login: $login) {
      login
      name
      contributionsCollection {
        contributionCalendar {
          totalContributions
          weeks {
            contributionDays {
              date
              contributionCount
              color
            }
          }
        }
        totalCommitContributions
        totalIssueContributions
        totalPullRequestContributions
        totalPullRequestReviewContributions
        startedAt
        endedAt
      }
    }
  }' -f login="$login"
fi
